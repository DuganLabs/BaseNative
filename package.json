{
  "name": "basenative",
  "version": "0.3.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npx nx serve basenative-example-express",
    "build:pages": "nx bundle basenative-example-express && node scripts/build-pages.js",
    "deploy": "pnpm build:pages && wrangler pages deploy dist --project-name basenative",
    "audit:axe": "node scripts/audit/axe.mjs",
    "audit:observatory": "node scripts/audit/observatory.mjs",
    "audit:ux": "node scripts/audit/laws-of-ux.mjs",
    "audit": "pnpm audit:axe && pnpm audit:ux",
    "bundle-size": "node scripts/bundle-size.js",
    "version": "changeset version && pnpm install --lockfile-only --ignore-scripts && node scripts/package-inventory.js && node scripts/llms-txt.js"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "nx": "^23.2.0",
    "nx-mcp": "^0.25.0",
    "prettier": "^3.9.6",
    "wrangler": "^4.129.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "nx",
      "@playwright/test",
      "sharp",
      "workerd"
    ]
  }
}
