{
  "name": "@basenative/middleware",
  "version": "0.4.0",
  "description": "Request pipeline middleware \u2014 security headers, CORS, rate limiting, CSRF, and adapters",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./express": {
      "types": "./types/express.d.ts",
      "default": "./src/adapters/express.js"
    },
    "./cors": {
      "types": "./types/cors.d.ts",
      "default": "./src/builtins/cors.js"
    },
    "./rate-limit": {
      "types": "./types/rate-limit.d.ts",
      "default": "./src/builtins/rate-limit.js"
    },
    "./csrf": {
      "types": "./types/csrf.d.ts",
      "default": "./src/builtins/csrf.js"
    },
    "./logger": {
      "types": "./types/logger.d.ts",
      "default": "./src/builtins/logger.js"
    },
    "./security-headers": {
      "types": "./types/security-headers.d.ts",
      "default": "./src/builtins/security-headers.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "!**/*.test.js",
    "!**/*.test.mjs"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuganLabs/BaseNative.git",
    "directory": "packages/middleware"
  },
  "homepage": "https://github.com/DuganLabs/BaseNative/tree/main/packages/middleware#readme",
  "bugs": {
    "url": "https://github.com/DuganLabs/BaseNative/issues"
  },
  "keywords": [
    "basenative",
    "middleware",
    "cors",
    "csrf",
    "security-headers",
    "csp",
    "rate-limiting"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
