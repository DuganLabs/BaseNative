{
  "name": "@basenative/runtime",
  "version": "3.1.0",
  "description": "Signal-based web runtime over native HTML \u2014 zero build step, zero production dependencies",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./shared/expression": {
      "types": "./types/shared/expression.d.ts",
      "default": "./src/shared/expression.js"
    },
    "./shared/escape": {
      "types": "./types/shared/escape.d.ts",
      "default": "./src/shared/escape.js"
    },
    "./shared/directives": {
      "types": "./types/shared/directives.d.ts",
      "default": "./src/shared/directives.js"
    },
    "./devtools": {
      "types": "./types/devtools.d.ts",
      "default": "./src/devtools.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "!**/*.test.js",
    "!**/*.test.mjs"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuganLabs/BaseNative.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/DuganLabs/BaseNative/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/DuganLabs/BaseNative/issues"
  },
  "keywords": [
    "basenative",
    "signals",
    "reactive",
    "ssr",
    "zero-dependencies",
    "llm",
    "generative-ui",
    "no-build",
    "csp",
    "html"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
