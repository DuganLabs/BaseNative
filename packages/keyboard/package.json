{
  "name": "@basenative/keyboard",
  "version": "1.0.6",
  "description": "Accessible mobile-first on-screen virtual keyboard primitive \u2014 layout-agnostic, signal-driven key state coloring, themable",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./css": "./src/styles.css",
    "./styles.css": "./src/styles.css"
  },
  "types": "./types/index.d.ts",
  "peerDependencies": {
    "@basenative/runtime": "workspace:*"
  },
  "files": [
    "src",
    "types",
    "!**/*.test.js",
    "!**/*.test.mjs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuganLabs/BaseNative.git",
    "directory": "packages/keyboard"
  },
  "homepage": "https://github.com/DuganLabs/BaseNative/tree/main/packages/keyboard#readme",
  "bugs": {
    "url": "https://github.com/DuganLabs/BaseNative/issues"
  },
  "keywords": [
    "basenative",
    "keyboard",
    "virtual-keyboard",
    "a11y",
    "wcag",
    "qwerty",
    "numpad",
    "signals"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
