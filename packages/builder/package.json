{
  "name": "@basenative/builder",
  "version": "0.2.1",
  "description": "Signal-based drag-and-drop component builder for BaseNative \u2014 composes layouts, generates clean BaseNative code",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./builder.css": "./src/builder.css"
  },
  "types": "./types/index.d.ts",
  "dependencies": {
    "@basenative/runtime": "workspace:*"
  },
  "files": [
    "src",
    "types",
    "!**/*.test.js",
    "!**/*.test.mjs"
  ],
  "sideEffects": [
    "./src/builder-element.js",
    "./src/canvas-element.js",
    "./src/palette-element.js",
    "./src/tree-element.js",
    "./src/inspector-element.js",
    "**/*.css"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuganLabs/BaseNative.git",
    "directory": "packages/builder"
  },
  "homepage": "https://github.com/DuganLabs/BaseNative/tree/main/packages/builder#readme",
  "bugs": {
    "url": "https://github.com/DuganLabs/BaseNative/issues"
  },
  "keywords": [
    "basenative",
    "builder",
    "visual-builder",
    "drag-and-drop",
    "signals",
    "code-generation",
    "no-code",
    "web-components"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
