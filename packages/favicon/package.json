{
  "name": "@basenative/favicon",
  "version": "1.0.3",
  "description": "SVG-first favicon generator + design primitives \u2014 apple-touch-icon, maskable, manifest, and the right <link> tags for every DuganLabs project",
  "type": "module",
  "bin": {
    "bn-favicon": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./presets": {
      "types": "./types/index.d.ts",
      "default": "./src/presets/dl.js"
    },
    "./render": {
      "types": "./types/index.d.ts",
      "default": "./src/render.js"
    },
    "./glyphs": {
      "types": "./types/index.d.ts",
      "default": "./src/glyphs.js"
    },
    "./palette": {
      "types": "./types/index.d.ts",
      "default": "./src/palette.js"
    },
    "./manifest": {
      "types": "./types/index.d.ts",
      "default": "./src/manifest.js"
    },
    "./png": {
      "types": "./types/index.d.ts",
      "default": "./src/png.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "templates",
    "CHANGELOG.md",
    "!**/*.test.js",
    "!**/*.test.mjs"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuganLabs/BaseNative.git",
    "directory": "packages/favicon"
  },
  "homepage": "https://github.com/DuganLabs/BaseNative/tree/main/packages/favicon#readme",
  "bugs": {
    "url": "https://github.com/DuganLabs/BaseNative/issues"
  },
  "keywords": [
    "basenative",
    "favicon",
    "svg",
    "apple-touch-icon",
    "maskable",
    "pwa",
    "manifest",
    "duganlabs"
  ],
  "optionalDependencies": {
    "@resvg/resvg-wasm": "^2.6.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
