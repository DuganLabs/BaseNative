{
  "name": "@basenative/og-image",
  "version": "0.3.1",
  "description": "Runtime-agnostic OG / social share PNG renderer — SVG card scenes rasterized by resvg-wasm, with CDN+KV-cached fonts; runs on Cloudflare Workers, Node, Deno and Bun",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./satori": {
      "types": "./types/satori.d.ts",
      "default": "./src/satori.js"
    },
    "./presets": {
      "types": "./types/presets.d.ts",
      "default": "./src/presets.js"
    },
    "./scene": {
      "types": "./types/scene.d.ts",
      "default": "./src/scene.js"
    }
  },
  "types": "./types/index.d.ts",
  "imports": {
    "#wasm-init": {
      "workerd": "./src/wasm.workerd.js",
      "browser": "./src/wasm.workerd.js",
      "default": "./src/wasm.node.js"
    }
  },
  "files": [
    "src",
    "types",
    "!**/*.test.js",
    "!**/*.test.mjs"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuganLabs/BaseNative.git",
    "directory": "packages/og-image"
  },
  "homepage": "https://github.com/DuganLabs/BaseNative/tree/main/packages/og-image#readme",
  "bugs": {
    "url": "https://github.com/DuganLabs/BaseNative/issues"
  },
  "keywords": [
    "basenative",
    "og-image",
    "social-share",
    "open-graph",
    "resvg",
    "satori",
    "cloudflare-workers",
    "edge"
  ],
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2"
  },
  "peerDependencies": {
    "satori": "^0.33.4"
  },
  "peerDependenciesMeta": {
    "satori": {
      "optional": true
    }
  },
  "devDependencies": {
    "satori": "^0.33.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
