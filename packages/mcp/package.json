{
  "name": "@basenative/mcp",
  "version": "0.2.3",
  "description": "MCP server exposing BaseNative validation, SSR preview, and directive reference to any agent",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "types": "./types/index.d.ts",
  "bin": {
    "basenative-mcp": "./src/bin.js"
  },
  "files": [
    "src",
    "types",
    "!**/*.test.js",
    "!**/*.test.mjs"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuganLabs/BaseNative.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/DuganLabs/BaseNative/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/DuganLabs/BaseNative/issues"
  },
  "keywords": [
    "basenative",
    "mcp",
    "model-context-protocol",
    "llm",
    "generative-ui"
  ],
  "dependencies": {
    "@basenative/validate": "workspace:^0.3.1",
    "@basenative/server": "workspace:^0.6.4",
    "@basenative/runtime": "workspace:^0.6.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
