{
  "name": "@basenative/ios",
  "targets": {
    "lint": {
      "cache": true,
      "command": "pnpm exec eslint src/",
      "inputs": ["{projectRoot}/src/**/*.js"],
      "options": { "cwd": "{projectRoot}" }
    },
    "test": {
      "cache": true,
      "command": "node --test src/tokens.test.js src/css.test.js src/index.test.js types/exports.test.js",
      "inputs": [
        "{projectRoot}/src/**/*.js",
        "{projectRoot}/src/**/*.css",
        "{projectRoot}/types/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/README.md"
      ],
      "options": { "cwd": "{projectRoot}" }
    }
  }
}
