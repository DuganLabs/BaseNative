{
  "name": "@basenative/theme",
  "version": "0.3.1",
  "description": "The theme layer behind @basenative/components — a four-tier token shape, a WCAG contrast harness that fails the build, a one-grid icon discipline and the --bn-* bridge",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./contrast": {
      "types": "./types/contrast.d.ts",
      "default": "./src/contrast.js"
    },
    "./audit": {
      "types": "./types/audit.d.ts",
      "default": "./src/audit.js"
    },
    "./css": {
      "types": "./types/css.d.ts",
      "default": "./src/css.js"
    },
    "./icons": {
      "types": "./types/icons.d.ts",
      "default": "./src/icons.js"
    },
    "./bridge.css": "./src/bridge.css"
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "test": "node --test src/contrast.test.js src/theme.test.js src/audit.test.js src/css.test.js src/icons.test.js src/bridge.test.js src/starter-guide.test.js types/exports.test.js"
  },
  "files": [
    "src",
    "types",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "!src/test-fixtures.js"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuganLabs/BaseNative.git",
    "directory": "packages/theme"
  },
  "homepage": "https://github.com/DuganLabs/BaseNative/tree/main/packages/theme#readme",
  "bugs": {
    "url": "https://github.com/DuganLabs/BaseNative/issues"
  },
  "keywords": [
    "basenative",
    "design-tokens",
    "theme",
    "wcag",
    "contrast",
    "accessibility",
    "design-system",
    "css-custom-properties"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
