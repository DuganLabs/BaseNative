{
  "name": "@basenative/server",
  "version": "2.3.2",
  "description": "Server-side rendering with streaming support for BaseNative templates",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/render.d.ts",
      "default": "./src/render.js"
    },
    "./stream": {
      "types": "./types/stream.d.ts",
      "default": "./src/stream.js"
    }
  },
  "types": "./types/render.d.ts",
  "dependencies": {
    "@basenative/runtime": "workspace:^2.3.2",
    "node-html-parser": "^9.0.4"
  },
  "devDependencies": {
    "@basenative/flags": "workspace:^2.3.2",
    "@basenative/i18n": "workspace:^2.3.2"
  },
  "files": [
    "src",
    "types",
    "!**/*.test.js",
    "!**/*.test.mjs"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuganLabs/BaseNative.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/DuganLabs/BaseNative/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/DuganLabs/BaseNative/issues"
  },
  "keywords": [
    "basenative",
    "ssr",
    "streaming",
    "server-rendering",
    "html-templates",
    "llm",
    "generative-ui",
    "no-build",
    "csp"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
