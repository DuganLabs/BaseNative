{
  "name": "@basenative/persist",
  "version": "1.0.6",
  "description": "Signal-driven local persistence with TTL, conflict resolution, and a server-rehydrate hook for BaseNative apps",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./storage": {
      "types": "./types/storage.d.ts",
      "default": "./src/storage.js"
    },
    "./ttl": {
      "types": "./types/ttl.d.ts",
      "default": "./src/ttl.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "!**/*.test.js",
    "!**/*.test.mjs"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuganLabs/BaseNative.git",
    "directory": "packages/persist"
  },
  "homepage": "https://github.com/DuganLabs/BaseNative/tree/main/packages/persist#readme",
  "bugs": {
    "url": "https://github.com/DuganLabs/BaseNative/issues"
  },
  "keywords": [
    "basenative",
    "signals",
    "persistence",
    "localstorage",
    "indexeddb",
    "ttl",
    "session-resume"
  ],
  "peerDependencies": {
    "@basenative/runtime": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@basenative/runtime": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
